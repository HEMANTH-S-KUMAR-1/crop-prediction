# Crop Prediction App - Environment Variables Template
# Copy this file to .env.local for local development

# App Configuration
VITE_APP_NAME=Crop Prediction System
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=production

# API Configuration
# The app currently uses free public APIs:
# - Open-Meteo for weather data (no key required)
# - Nominatim for geocoding (no key required)

# API Configuration - Open-Meteo APIs (Free, no key required)
VITE_OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
VITE_OPEN_METEO_HISTORICAL_URL=https://archive-api.open-meteo.com/v1/archive
VITE_OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
VITE_OPEN_METEO_CLIMATE_URL=https://climate-api.open-meteo.com/v1/climate

# Optional: SoilGrids API for soil data (free)
# VITE_SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0

# Optional: If you want to switch to premium APIs in the future
# VITE_WEATHER_API_KEY=your_weather_api_key_here
# VITE_GEOCODING_API_KEY=your_geocoding_api_key_here

# Analytics (Optional)
# VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Error Monitoring (Optional)
# VITE_SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_LOGS=false

# API Configuration
VITE_API_RATE_LIMIT=10000
VITE_API_CACHE_DURATION=300000